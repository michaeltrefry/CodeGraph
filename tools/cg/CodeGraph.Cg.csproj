<Project Sdk="Microsoft.NET.Sdk">

  <!--
    cg: the CodeGraph command line for hooks and shell-capable agents (agent coordination S2).
    No package dependencies, REST only. Run the built cg.dll with dotnet, or pack it as a .NET tool
    (dotnet pack, then dotnet tool install from the package folder) to get a `cg` command.
    `cg help` lists the commands and the environment it reads.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>cg</AssemblyName>
    <RootNamespace>CodeGraph.Cg</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cg</ToolCommandName>
    <PackageId>CodeGraph.Cg</PackageId>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
