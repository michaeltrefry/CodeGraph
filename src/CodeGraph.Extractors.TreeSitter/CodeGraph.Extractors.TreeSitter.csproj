<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <PackageReference Include="TreeSitter.DotNet" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeGraph.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeGraph.Models\CodeGraph.Models.csproj" />
    <ProjectReference Include="..\CodeGraph.Services\CodeGraph.Services.csproj" />
  </ItemGroup>

  <!--
    Swift grammar (libtree-sitter-swift). TreeSitter.DotNet does not ship it, so it is compiled
    from pinned, sha256-verified generated sources by native/build-tree-sitter-swift.sh and copied
    next to the app, where `new Language("Swift")` loads it (AppContext.BaseDirectory is the
    loader's first probe). The library flows to every referencing project's output and publish.
    Docker images build it in a separate stage and pass it in via TreeSitterSwiftLibrary.
    Supported hosts: Linux (x64/arm64) and macOS (arm64). Windows builds skip it; Swift files are
    then logged and skipped by the extractor.
  -->
  <PropertyGroup>
    <TreeSitterSwiftGrammarScript>$(MSBuildThisFileDirectory)native/build-tree-sitter-swift.sh</TreeSitterSwiftGrammarScript>
    <!-- The target OS decides the library name: the RuntimeIdentifier when one is set, else the host. -->
    <TreeSitterSwiftLibraryFileName Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">libtree-sitter-swift.dylib</TreeSitterSwiftLibraryFileName>
    <TreeSitterSwiftLibraryFileName Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">libtree-sitter-swift.so</TreeSitterSwiftLibraryFileName>
    <TreeSitterSwiftLibraryFileName Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx'))">libtree-sitter-swift.dylib</TreeSitterSwiftLibraryFileName>
    <TreeSitterSwiftLibraryFileName Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux'))">libtree-sitter-swift.so</TreeSitterSwiftLibraryFileName>
    <BuildTreeSitterSwift Condition="'$(TreeSitterSwiftLibraryFileName)' != '' and '$(TreeSitterSwiftLibrary)' == ''">true</BuildTreeSitterSwift>
    <TreeSitterSwiftLibrary Condition="'$(BuildTreeSitterSwift)' == 'true'">$(MSBuildThisFileDirectory)obj/native/$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())/$(TreeSitterSwiftLibraryFileName)</TreeSitterSwiftLibrary>
  </PropertyGroup>

  <ItemGroup Condition="'$(TreeSitterSwiftLibrary)' != ''">
    <None Include="$(TreeSitterSwiftLibrary)"
          Link="$(TreeSitterSwiftLibraryFileName)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <Target Name="CheckTreeSitterSwiftTarget" Condition="'$(BuildTreeSitterSwift)' == 'true'">
    <!-- The build script compiles for the host only; a cross-RID build must supply the library. -->
    <Error Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != '$(NETCoreSdkPortableRuntimeIdentifier)'"
           Text="The tree-sitter Swift grammar is compiled for the host ($(NETCoreSdkPortableRuntimeIdentifier)), not for RuntimeIdentifier '$(RuntimeIdentifier)'. Build libtree-sitter-swift for that target with src/CodeGraph.Extractors.TreeSitter/native/build-tree-sitter-swift.sh and pass it with -p:TreeSitterSwiftLibrary=&lt;path&gt;." />
  </Target>

  <Target Name="BuildTreeSitterSwiftGrammar"
          BeforeTargets="BeforeBuild"
          DependsOnTargets="CheckTreeSitterSwiftTarget"
          Condition="'$(BuildTreeSitterSwift)' == 'true'"
          Inputs="$(TreeSitterSwiftGrammarScript)"
          Outputs="$(TreeSitterSwiftLibrary)">
    <Exec Command="sh &quot;$(TreeSitterSwiftGrammarScript)&quot; &quot;$(TreeSitterSwiftLibrary)&quot;" />
  </Target>

  <Target Name="VerifyTreeSitterSwiftLibrary"
          BeforeTargets="BeforeBuild"
          AfterTargets="BuildTreeSitterSwiftGrammar"
          Condition="'$(TreeSitterSwiftLibrary)' != ''">
    <Error Condition="!Exists('$(TreeSitterSwiftLibrary)')"
           Text="tree-sitter Swift grammar not found at '$(TreeSitterSwiftLibrary)'." />
  </Target>

</Project>
